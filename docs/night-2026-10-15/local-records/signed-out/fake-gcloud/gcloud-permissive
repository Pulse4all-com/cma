#!/bin/bash
echo "gcloud $*" >> "$FAKE_LOG"
args="$*"
case "$args" in
  *"org-policies describe"*) echo "${FAKE_PAP:-}"; exit 0 ;;
  *"storage buckets describe"*) [ -n "${FAKE_BUCKET:-}" ] && { case "$args" in *location*) echo EUROPE-WEST4;; *public_access_prevention*) echo inherited;; *) echo name;; esac; exit 0; } ; exit 1 ;;
  *"storage buckets get-iam-policy"*) echo '{}'; exit 0 ;;
  *"compute backend-buckets describe"*) exit 1 ;;
  *"ssl-certificates describe"*) echo "workspace.example.test"; exit 0 ;;
  *"backend-services describe"*"loadBalancingScheme"*) echo EXTERNAL_MANAGED; exit 0 ;;
  *"backend-services describe"*"selfLink"*) echo "https://www.googleapis.com/compute/v1/projects/p4a-cma-prod/global/backendServices/cma-web-backend"; exit 0 ;;
  *"url-maps export"*) dest="${args##*--destination=}"; dest="${dest%% *}"; echo "# fake export" > "$dest"; exit 0 ;;
  *"url-maps describe"*) cat "$FAKE_URLMAP"; exit 0 ;;
  *"url-maps validate"*) echo '{"result":{"loadSucceeded":true,"testPassed":true}}'; exit 0 ;;
  *"storage ls"*) printf "gs://p4a-cma-prod-signed-out/signed-out\ngs://p4a-cma-prod-signed-out/signed-out/logo-blue.png\ngs://p4a-cma-prod-signed-out/signed-out/Montserrat-VF.ttf\n${FAKE_EXTRA:-}"; exit 0 ;;
  *) echo "MUTATION $args" >> "$FAKE_LOG"; exit 0 ;;
esac
