{
  "name": "cma-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The CMA ingest service and its jobs: webhooks from connected systems (HubSpot, Aircall, Shopify), read-back and upsert into Postgres, sweep, forms poll, reconcile, backfill and the outbox (README Architecture, Ingest API)",
  "scripts": {
    "start": "node src/server.mjs",
    "lint": "eslint",
    "test": "npm run verify:signature && npm run verify:mapping && npm run verify:hash && npm run verify:forms && npm run verify:aircall-token && npm run verify:aircall-mapping && npm run verify:aircall-scripts && npm run verify:shopify-signature && npm run verify:shopify-mapping && npm run verify:shopify-client && npm run verify:shopify-scripts && npm run verify:outbox",
    "verify:signature": "node verify/signature.mjs",
    "verify:mapping": "node verify/mapping.mjs",
    "verify:hash": "node verify/hash.mjs",
    "verify:forms": "node verify/forms.mjs",
    "verify:aircall-token": "node verify/aircall-token.mjs",
    "verify:aircall-mapping": "node verify/aircall-mapping.mjs",
    "verify:aircall-scripts": "node verify/aircall-scripts.mjs",
    "verify:shopify-signature": "node verify/shopify-signature.mjs",
    "verify:shopify-mapping": "node verify/shopify-mapping.mjs",
    "verify:shopify-client": "node verify/shopify-client.mjs",
    "verify:shopify-scripts": "node verify/shopify-scripts.mjs",
    "verify:outbox": "node verify/outbox.mjs",
    "verify:flow": "node verify/flow.mjs",
    "verify:jobs-flow": "node verify/jobs-flow.mjs",
    "verify:aircall-flow": "node verify/aircall-flow.mjs",
    "verify:shopify-flow": "node verify/shopify-flow.mjs",
    "verify:outbox-flow": "node verify/outbox-flow.mjs",
    "job:sweep": "node jobs/sweep.mjs",
    "job:poll-forms": "node jobs/poll-forms.mjs",
    "job:reconcile": "node jobs/reconcile.mjs",
    "job:backfill": "node jobs/backfill.mjs",
    "job:outbox": "node jobs/outbox.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
