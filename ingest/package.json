{
  "name": "cma-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The CMA ingest service: webhooks from connected systems, read-back and upsert into Postgres (README Architecture, Ingest API)",
  "scripts": {
    "start": "node src/server.mjs",
    "lint": "eslint",
    "test": "npm run verify:signature && npm run verify:mapping && npm run verify:hash",
    "verify:signature": "node verify/signature.mjs",
    "verify:mapping": "node verify/mapping.mjs",
    "verify:hash": "node verify/hash.mjs",
    "verify:flow": "node verify/flow.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
