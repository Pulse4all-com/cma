{
  "name": "cma-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/documents-manifest.mjs",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:copy": "node verify/copy.mjs",
    "verify:boundaries": "node verify/boundaries.mjs",
    "verify:theme": "node verify/theme.mjs",
    "verify:round-trips": "node verify/round-trips.mjs",
    "verify:layout": "node verify/layout.mjs",
    "verify:hints": "node verify/hints.mjs",
    "verify:iap": "node verify/iap-token.mjs",
    "verify:api": "node verify/api.mjs",
    "verify:corrections": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/corrections.mjs",
    "verify:csv": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/csv.mjs",
    "verify:dashboard": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/dashboard.mjs",
    "verify:live": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/live.mjs",
    "verify:team": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/team.mjs",
    "verify:roster": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/roster.mjs",
    "verify": "npm run verify:copy && npm run verify:corrections && npm run verify:csv && npm run verify:dashboard && npm run verify:live && npm run verify:team && npm run verify:roster && npm run verify:preview && npm run verify:follow-up && npm run verify:configuration && npm run verify:messages && npm run verify:import && npm run verify:datamap && npm run verify:reports && npm run verify:theme && npm run verify:layout && npm run verify:hints",
    "verify:configuration": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/configuration.mjs",
    "verify:scheduler": "node verify/scheduler.mjs",
    "job:close-forgotten": "node jobs/close-forgotten-workdays.mjs",
    "verify:messages": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/messages.mjs",
    "verify:import": "node ../tools/verify-legacy-sessions.mjs",
    "verify:datamap": "node ../tools/datamap/verify.mjs",
    "verify:reports": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/reports.mjs",
    "verify:signed-out": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/signed-out.mjs",
    "verify:invitations": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/invitations.mjs",
    "verify:preview": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/preview.mjs",
    "verify:follow-up": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/follow-up.mjs",
    "verify:health": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify/health.mjs",
    "verify:jobs": "node verify/jobs.mjs",
    "verify:refresh-follow-up": "node verify/refresh-follow-up.mjs"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
