# Copy to .env.local for local development. Cloud Run sets these on the service.
CMA_AUTH_MODE=mock      # iap | mock   (fail closed: unset means iap)
CMA_DATA_MODE=mock      # api | mock   (fail closed: unset means api)
CMA_DEFAULT_LOCALE=en   # en | nl
IAP_AUDIENCE=           # /projects/467777891162/global/backendServices/<backend id>
IAP_JWKS_URL=           # leave empty in prod; verify/iap-token.mjs points it at a test key set
